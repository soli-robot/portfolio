# Ignore system files
.DS_Store
Thumbs.db

# Ignore large media files
*.mp4
*.avi
*.mkv
*.mov

# Ignore secrets and key files
*firebase*.json
*adminsdk*.json
*.key
*.pem

# Ignore archives
*.zip
*.tar.gz
*.rar
projects/**/zip/

# Ignore databases and local configs
*.db
*.sqlite
.env
*.env

# Python caching
__pycache__/
*.pyc
*.pyo

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Logs and databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node modules (just in case)
node_modules/
